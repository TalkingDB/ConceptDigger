{
    "name": "ConceptDigger Dev Environment",
    "dockerComposeFile": [
        "../docker-compose.yml",
        "docker-compose.yml"
    ],
    "service": "conceptdigger",
    "workspaceFolder": "/app",
    "runServices": [
        "conceptdigger",
        "elasticsearch"
    ],
    "shutdownAction": "stopCompose",
    "initializeCommand": {
        "windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"if (!(Test-Path '${localWorkspaceFolder}\\.env')) { Copy-Item '${localWorkspaceFolder}\\.env.example' '${localWorkspaceFolder}\\.env' }\"",
        "linux": "sh -c 'test -f .env || cp .env.example .env'",
        "osx": "sh -c 'test -f .env || cp .env.example .env'"
    },
    "containerEnv": {
        "PORT": "5007",
        "SPARQL_ENDPOINT": "https://dbpedia.org/sparql",
        "CACHE_FILE_PATH": "data/graph_cache.json",
        "ELASTICSEARCH_URL": "http://elasticsearch:9200"
    },
    "forwardPorts": [
        5007,
        9200
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ]
        }
    },
    "postCreateCommand": "apt-get update && apt-get install -y git && pip install --no-cache-dir gdown==5.2.0 \"pytest>=8,<9\" \"pytest-asyncio>=0.24,<1\" \"pytest-html>=4,<5\" && bash .devcontainer/fetch_graph_cache.sh",
    "postStartCommand": "nohup uvicorn app.main:app --host 0.0.0.0 --port 5007 --reload > uvicorn.log 2>&1 &"
}